# Committed intentionally, with EMPTY values, so Coolify picks up the variable
# names and lists them in its UI ready to be filled in.
#
# Values belong in the Coolify UI, not here. Leave the right-hand sides blank in
# git -- if you fill one in locally, do not commit that change.

# --- required; the container refuses to start without these ---
NEON_DATABASE_URL=
REVIEW_USERS=
# Set this in the Coolify UI. For a generated value, put the literal
# ${SERVICE_HEX_SESSION} in as the VALUE -- Coolify resolves it to 32 hex chars.
SESSION_SECRET=

# --- page images: set ALL FOUR, or NONE ---
# A partial set is rejected at startup rather than silently falling back to a
# local render that cannot work inside a container.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- optional; the app has defaults (pages / 3600) ---
R2_PREFIX=
R2_SIGN_TTL=
