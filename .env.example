# Template only -- NAMES, NOT VALUES. Copy to .env for local use, or type these
# names into the Coolify UI for a deployment. The real .env is gitignored and
# must never be committed: it would put the Neon password and the R2 keys into
# the repository.
#
# Coolify does NOT read this file. It exists so the required variable names are
# discoverable without reading the app source. In Coolify you add them in the
# UI, which is deliberate -- naming them in docker-compose.yml would bind them
# to that file and Coolify would then refuse to let you edit them.

# --- required; the app refuses to start without these ---
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# "name:password,name:password" -- the name becomes part of the ocr_reading
# method, so each reviewer's corrections stay attributable to them.
REVIEW_USERS=alden:change-me,jeff:change-me-too

# Signs the login cookie. Any long random string. Changing it logs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# --- page images: set ALL FOUR, or NONE ---
# A partial set is rejected at startup rather than silently falling back to a
# local render that cannot work inside a container.
R2_BUCKET=dobbins-paperless-scans
R2_ENDPOINT=https://68cc04bc26e145bfaf919bd02eb787d8.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- optional; the app has defaults ---
# R2_PREFIX=pages
# R2_SIGN_TTL=3600

# --- local development only ---
# Where the recut PDFs live, for rendering page images without R2.
# PAGE_SOURCE=C:\Users\busin\Documents\Document Splitting for Paperless\recut
