# ---- data: 7.5 GB, never in git ----
recut/
genius scan v2 from google drive/
ocr-mistral/
splits/
pages/
raw/
archive/
align-cache/
embedded/
embedded-test/
ocr-smoke/
out/
ocr/

# large derived artifacts
recut-manifest.json
supermemory-backlog.json

# GitHub hard-rejects >100MB; the Farmers policy alone is 118MB
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# secrets
*.env
# .env IS tracked, with empty values only, so Coolify reads the variable names
# out of the repo and lists them in its UI ready to fill in. Values live in
# Coolify, never here.
!.env

# recovered session transcripts - full tool output, includes connection strings
_session-recovery-backup/

# Database exports. The Papra export in this folder carries LIVE auth_sessions
# and api_keys rows -- one stray `git add -A` must never be able to publish it.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Claude Code session state and git worktrees
.claude/

__pycache__/
*.pyc
.venv/

# v2 build output
v2/target/
v2/web/node_modules/
v2/web/dist/
